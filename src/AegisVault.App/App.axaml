<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="AegisVault.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme variant; "Dark" / "Light" force a specific one. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AegisSidebarBrush" Color="#FBFBFC" />
                    <SolidColorBrush x:Key="AegisHairlineBrush" Color="#ECECEE" />
                    <SolidColorBrush x:Key="AegisHoverBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AegisSelectedBrush" Color="#EFEFF1" />
                    <SolidColorBrush x:Key="AegisChipBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AegisChipSelectedBrush" Color="#E7E7E9" />
                    <SolidColorBrush x:Key="AegisCardBorderBrush" Color="Transparent" />
                    <!-- "Drop into this category": a primary tint that reads as a surface,
                         deliberately different from the insertion bar used for siblings. -->
                    <SolidColorBrush x:Key="AegisDropIntoBrush" Color="#D9EEE6" />
                    <SolidColorBrush x:Key="AegisDropIntoBorderBrush" Color="#0F6B4F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AegisSidebarBrush" Color="#0E0E10" />
                    <SolidColorBrush x:Key="AegisHairlineBrush" Color="#232326" />
                    <SolidColorBrush x:Key="AegisHoverBrush" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="AegisSelectedBrush" Color="#232329" />
                    <SolidColorBrush x:Key="AegisChipBrush" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="AegisChipSelectedBrush" Color="#26262B" />
                    <SolidColorBrush x:Key="AegisCardBorderBrush" Color="#232326" />
                    <!-- Dark counterpart of the "drop into" tint. -->
                    <SolidColorBrush x:Key="AegisDropIntoBrush" Color="#16352A" />
                    <SolidColorBrush x:Key="AegisDropIntoBorderBrush" Color="#1F8A63" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Shared dialog/form styles -->
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AegisCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Category rows: the per-row action menu only shows on hover/selection. -->
        <Style Selector="ListBox.categories ListBoxItem StackPanel.categoryActions">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.categories ListBoxItem:pointerover StackPanel.categoryActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.categories ListBoxItem:selected StackPanel.categoryActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>
</Application>
