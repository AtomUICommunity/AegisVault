<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="AegisVault.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme variant; "Dark" / "Light" force a specific one. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--
                    Sidebar surface ramp. Every state shares the brand green hue (~162 light,
                    ~158 dark) and only varies saturation/lightness, so hovering and selecting
                    read as "the same ink, more of it" instead of a neutral grey fighting the
                    accent colour. Steps are at least 0.045 apart in relative luminance, which
                    keeps them distinguishable, and the darkest step still holds >= 11:1
                    contrast against body text.
                -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AegisSidebarBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="AegisHairlineBrush" Color="#EAEFEC" />
                    <SolidColorBrush x:Key="AegisHoverBrush" Color="#F2F5F4" />
                    <SolidColorBrush x:Key="AegisSelectedBrush" Color="#E7ECEA" />
                    <!-- Pointer over an already-selected row: darker still, so it responds. -->
                    <SolidColorBrush x:Key="AegisSelectedHoverBrush" Color="#DCE5E2" />
                    <SolidColorBrush x:Key="AegisChipBrush" Color="#F2F5F4" />
                    <SolidColorBrush x:Key="AegisChipSelectedBrush" Color="#E7ECEA" />
                    <SolidColorBrush x:Key="AegisCardBorderBrush" Color="Transparent" />
                    <!-- "Drop into this category": the most saturated step of the ramp, so it
                         outranks selection instead of blending into it. -->
                    <SolidColorBrush x:Key="AegisDropIntoBrush" Color="#CAE2DB" />
                    <SolidColorBrush x:Key="AegisDropIntoBorderBrush" Color="#0F6B4F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AegisSidebarBrush" Color="#0C0E0D" />
                    <SolidColorBrush x:Key="AegisHairlineBrush" Color="#212724" />
                    <SolidColorBrush x:Key="AegisHoverBrush" Color="#161B19" />
                    <SolidColorBrush x:Key="AegisSelectedBrush" Color="#1E2724" />
                    <SolidColorBrush x:Key="AegisSelectedHoverBrush" Color="#23312C" />
                    <SolidColorBrush x:Key="AegisChipBrush" Color="#161B19" />
                    <SolidColorBrush x:Key="AegisChipSelectedBrush" Color="#1E2724" />
                    <SolidColorBrush x:Key="AegisCardBorderBrush" Color="#212724" />
                    <SolidColorBrush x:Key="AegisDropIntoBrush" Color="#254138" />
                    <SolidColorBrush x:Key="AegisDropIntoBorderBrush" Color="#1F8A63" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Shared dialog/form styles -->
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AegisCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Category rows: the per-row action menu only shows on hover/selection. -->
        <Style Selector="ListBox.categories ListBoxItem StackPanel.categoryActions">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.categories ListBoxItem:pointerover StackPanel.categoryActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.categories ListBoxItem:selected StackPanel.categoryActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>
</Application>
