<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:conv="using:AegisVault.App.Converters"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        x:Class="AegisVault.App.Views.CategoryParentWindow"
        Icon="/Assets/app.png"
        Width="440"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{atom:SharedTokenResource ColorBgContainer}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Window.Resources>
        <conv:CategoryPickerIndentConverter x:Key="PickerIndentConverter" />
        <conv:CategoryGuideLinesConverter x:Key="PickerGuideConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Indented picker row: guide lines mark the parent chain so nesting is readable
             at a glance, which a pure pixel offset is not at this depth. -->
        <Style Selector="ListBox.picker ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!-- The picker's own class name gets no state styling from the theme, so without
             these rules a selected row fell back to Fluent's system accent (blue) while the
             rest of the app is brand green. Same failure as P-71. -->
        <Style Selector="ListBox.picker ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.picker ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisHoverBrush}" />
        </Style>
        <Style Selector="ListBox.picker ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedHoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="40,*,Auto">
        <controls:AegisTitleBar x:Name="TitleBar" Grid.Row="0" ShowIcon="True" />

        <Grid Grid.Row="1" Margin="20,4,20,0" RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
            <ListBox x:Name="ParentList"
                     Grid.Row="1"
                     Classes="picker"
                     AutomationProperties.AutomationId="CategoryParentList"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CategoryChoice">
                        <Grid ColumnDefinitions="Auto,Auto,*" Height="24">
                            <!-- Guide lines: one per *ancestor* (depth - 1), drawn inside the
                                 indent band so they mark the parent chain without adding to
                                 the step width. -->
                            <ItemsControl Grid.Column="0"
                                          ItemsSource="{Binding Depth, Converter={StaticResource PickerGuideConverter}}"
                                          VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="16"
                                                BorderBrush="{atom:SharedTokenResource ColorBorder}"
                                                BorderThickness="1,0,0,0"
                                                Margin="0,2,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Indent for this level sits *behind* the guide band so the total
                                 step stays 16px per level. -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="20">
            <atom:Button x:Name="CancelButton"
                         Content="{loc:Str Common_Cancel}"
                         Click="OnCancelClicked"
                         IsCancel="True" />
            <atom:Button x:Name="OkButton"
                         ButtonType="Primary"
                         Content="{loc:Str Common_Ok}"
                         Click="OnOkClicked"
                         IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
