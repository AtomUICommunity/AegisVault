<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        xmlns:antd="https://atomui.net/icons/antdesign"
        x:Class="AegisVault.App.Views.UnlockWindow"
        x:DataType="vm:UnlockViewModel"
        Icon="/Assets/app.png"
        Title="{loc:Str App_Title}"
        Width="560"
        Height="740"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="OnVaultFileDropped"
        Background="{atom:SharedTokenResource ColorBgContainer}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Window.Styles>
        <!-- Field-level validation messages sit directly under their input. -->
        <Style Selector="TextBlock.field-error">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="40,*">
        <controls:AegisTitleBar Grid.Row="0" Title="{loc:Str App_Title}" ShowIcon="True" />

        <Border Grid.Row="1" Padding="24,20,24,24">
            <Border MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Padding="28,24">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="16">
                    <StackPanel Grid.Row="0" Spacing="8">
                        <Border Width="52" Height="52"
                                CornerRadius="14"
                                HorizontalAlignment="Center"
                                Background="{atom:SharedTokenResource ColorPrimaryBg}">
                            <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                                 Foreground and PathIcon type selectors (see pitfall P-06). -->
                            <atom:Button ButtonType="Text"
                                         IsHitTestVisible="False"
                                         Focusable="False"
                                         Width="26" Height="26"
                                         MinWidth="0" MinHeight="0"
                                         Padding="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{atom:SharedTokenResource ColorPrimary}"
                                         Icon="{antd:AntDesignIconProvider SafetyCertificateFilled}" />
                        </Border>
                        <TextBlock Text="{loc:Str App_Title}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Unlock_Subtitle}"
                                   FontSize="13"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <atom:Segmented Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                        <atom:SegmentedItem Content="{loc:Str Unlock_TabOpen}" />
                        <atom:SegmentedItem Content="{loc:Str Unlock_TabCreate}" />
                    </atom:Segmented>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0" Spacing="14">
                            <StackPanel Spacing="14" IsVisible="{Binding !IsCreateMode}">
                                <!-- Recent vaults: one row per remembered vault that still exists. -->
                                <StackPanel Spacing="6" IsVisible="{Binding HasRecentVaultItems}">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_RecentVaults}" />
                                    <ItemsControl ItemsSource="{Binding RecentVaultItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentVaultItem">
                                                <atom:Button ButtonType="Link"
                                                             HorizontalAlignment="Left"
                                                             HorizontalContentAlignment="Left"
                                                             Padding="0"
                                                             Margin="0,0,0,2"
                                                             Content="{Binding FileName}"
                                                             ToolTip.Tip="{Binding}"
                                                             Command="{Binding $parent[ItemsControl].((vm:UnlockViewModel)DataContext).SelectRecentVaultCommand}"
                                                             CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_VaultFile}" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <atom:LineEdit Grid.Column="0" Text="{Binding VaultPath}" />
                                        <atom:Button Grid.Column="2"
                                                     ButtonType="Default"
                                                     Content="{loc:Str Common_Browse}"
                                                     Click="OnBrowseExistingClicked" />
                                    </Grid>
                                    <TextBlock Classes="field-error"
                                               Text="{Binding PathError}"
                                               IsVisible="{Binding PathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_MasterPassword}" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <atom:LineEdit x:Name="OpenPasswordBox"
                                                       Grid.Column="0"
                                                       PasswordChar="●"
                                                       IsEnableRevealButton="True"
                                                       Text="{Binding MasterPassword, Mode=TwoWay}" />
                                        <atom:Button Grid.Column="2"
                                                     ButtonType="Default"
                                                     Content="{loc:Str Unlock_SecureInput}"
                                                     IsVisible="{Binding SecureInputAvailable}"
                                                     Click="OnSecureInputClicked" />
                                    </Grid>
                                    <TextBlock Classes="field-error"
                                               Text="{Binding PasswordError}"
                                               IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <atom:CheckBox IsChecked="{Binding RememberDevice, Mode=TwoWay}"
                                               IsVisible="{Binding CanRememberDevice}">
                                    <TextBlock Text="{loc:Str Unlock_RememberDevice}" TextWrapping="Wrap" />
                                </atom:CheckBox>
                            </StackPanel>

                            <StackPanel Spacing="14" IsVisible="{Binding IsCreateMode}">
                                <!-- First run (no known vault): welcome block. -->
                                <Border IsVisible="{Binding IsFirstRun}"
                                        CornerRadius="10"
                                        Padding="14,12"
                                        Background="{atom:SharedTokenResource ColorPrimaryBg}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Str Unlock_FirstRunTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{atom:SharedTokenResource ColorPrimary}" />
                                        <TextBlock Text="{loc:Str Unlock_FirstRunHint}"
                                                   FontSize="12"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_SaveLocation}" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <atom:LineEdit Grid.Column="0" Text="{Binding NewVaultPath}" />
                                        <atom:Button Grid.Column="2"
                                                     ButtonType="Default"
                                                     Content="{loc:Str Unlock_ChooseLocation}"
                                                     Click="OnBrowseCreateClicked" />
                                    </Grid>
                                    <TextBlock Classes="field-error"
                                               Text="{Binding NewVaultPathError}"
                                               IsVisible="{Binding NewVaultPathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding NewVaultPathHint}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_MasterPassword}" />
                                    <atom:LineEdit x:Name="CreatePasswordBox"
                                                   PasswordChar="●"
                                                   IsEnableRevealButton="True"
                                                   Text="{Binding MasterPassword, Mode=TwoWay}" />
                                    <TextBlock Classes="field-error"
                                               Text="{Binding PasswordError}"
                                               IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{loc:Str Unlock_PasswordHint}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap" />
                                    <atom:ProgressBar Value="{Binding MasterPasswordStrengthPercent}"
                                                      Maximum="100"
                                                      Height="6"
                                                      Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding MasterPasswordStrengthSummary}"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field" Text="{loc:Str Unlock_ConfirmMasterPassword}" />
                                    <atom:LineEdit PasswordChar="●"
                                                   IsEnableRevealButton="True"
                                                   Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                    <TextBlock Classes="field-error"
                                               Text="{Binding ConfirmPasswordError}"
                                               IsVisible="{Binding ConfirmPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <atom:CheckBox IsChecked="{Binding RememberDevice, Mode=TwoWay}"
                                               IsVisible="{Binding CanRememberDevice}">
                                    <TextBlock Text="{loc:Str Unlock_RememberDevice}" TextWrapping="Wrap" />
                                </atom:CheckBox>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                                         Foreground and PathIcon type selectors (see pitfall P-06). -->
                                    <atom:Button ButtonType="Text"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"
                                                 Width="16" Height="16"
                                                 MinWidth="0" MinHeight="0"
                                                 Padding="0"
                                                 VerticalAlignment="Top"
                                                 Margin="0,1,0,0"
                                                 Foreground="{atom:SharedTokenResource ColorWarning}"
                                                 Icon="{antd:AntDesignIconProvider WarningOutlined}" />
                                    <TextBlock Text="{loc:Str Unlock_Warning}"
                                               Foreground="{atom:SharedTokenResource ColorWarning}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3"
                               Text="{Binding ErrorMessage}"
                               Foreground="{atom:SharedTokenResource ColorError}"
                               TextWrapping="Wrap"
                               MinHeight="20" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding BusyText}"
                               IsVisible="{Binding IsBusy}"
                               Opacity="0.6" />
                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
                        <!-- Version sits on the button row so it costs no vertical space;
                             the window is height-constrained and its content scrolls. -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VersionText}"
                                   FontSize="11"
                                   Opacity="0.45"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <atom:Button ButtonType="Primary"
                                         Content="{loc:Str Unlock_CreateVault}"
                                         Command="{Binding CreateCommand}"
                                         IsVisible="{Binding IsCreateMode}"
                                         IsDefault="True" />
                            <atom:Button ButtonType="Primary"
                                         Content="{loc:Str Unlock_Unlock}"
                                         Command="{Binding UnlockCommand}"
                                         IsVisible="{Binding !IsCreateMode}"
                                         IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
