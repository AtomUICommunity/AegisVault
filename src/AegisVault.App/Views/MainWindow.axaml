<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:models="using:AegisVault.Core.Models"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:conv="using:AegisVault.App.Converters"
        xmlns:anim="using:Avalonia.Animation"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        xmlns:antd="https://atomui.net/icons/antdesign"
        x:Class="AegisVault.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.png"
        Title="{loc:Str App_Title}"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AegisSidebarBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Window.Resources>
        <conv:InitialConverter x:Key="InitialConverter" />
        <conv:InitialTileBackgroundConverter x:Key="TileBackgroundConverter" />
        <conv:InitialTileForegroundConverter x:Key="TileForegroundConverter" />
        <conv:CategoryIconConverter x:Key="CategoryIconConverter" />
        <conv:CategoryDotConverter x:Key="CategoryDotConverter" />
        <conv:ThemeIconConverter x:Key="ThemeIconConverter" />

        <!-- Category tree row: colour dot, name, per-row action menu and branch count.
             The view assigns it to every CategoryNavNode (AtomUI falls back to a
             TreeDataTemplate otherwise, which would render the node itself). -->
        <DataTemplate x:Key="CategoryRowTemplate" DataType="vm:CategoryNavNode" x:DataType="vm:CategoryNavNode">
            <!-- The label area selects the category (parents included), while the row's
                 arrow column stays with the NavMenu and keeps toggling. The Border marks
                 the pointer press as handled so AtomUI's row activation never runs; the
                 "…" button inside shields itself the same way. -->
            <Border Classes="categoryRowLabel"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="6"
                    Focusable="True"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding Item.DisplayName}"
                    PointerPressed="OnCategoryRowLabelPress"
                    KeyDown="OnCategoryRowLabelKeyDown">
                <!-- The drop marker is a sibling of the content (not part of the
                     grid), so it can sit on the row's top edge and stretch the
                     full sidebar width. Code-behind shows it for exactly the row
                     the pointer hovers; a binding would need a rebuild per move. -->
                <Panel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Margin="4,0,12,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Item, Converter={StaticResource CategoryDotConverter}}" />
                        <TextBlock Grid.Column="1"
                                   AutomationProperties.AutomationId="CategoryNameText"
                                   Text="{Binding Item.DisplayName}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2"
                                    Classes="categoryActions"
                                    Orientation="Horizontal"
                                    Spacing="0"
                                    VerticalAlignment="Center">
                            <atom:Button ButtonType="Text"
                                         AutomationProperties.AutomationId="CategoryActionsButton"
                                         Icon="{antd:AntDesignIconProvider EllipsisOutlined}"
                                         ToolTip.Tip="{loc:Str Main_CategoryActionsTooltip}"
                                         Click="OnCategoryActionsClicked" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   AutomationProperties.AutomationId="CategoryCountText"
                                   Text="{Binding Item.Count}"
                                   FontSize="11"
                                   Opacity="0.5"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="CategoryDropBefore"
                            Height="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            CornerRadius="1"
                            Opacity="0"
                            IsHitTestVisible="False"
                            Background="{atom:SharedTokenResource ColorPrimary}" />
                </Panel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Chips -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource AegisHoverBrush}" />
        </Style>
        <Style Selector="Button.chip:pressed">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource AegisChipSelectedBrush}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource AegisChipSelectedBrush}" />
        </Style>
        <!-- Neutral selection/hover (Fluent defaults are blue) -->
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisHoverBrush}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisHoverBrush}" />
        </Style>
        <!-- Sidebar rows -->
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem StackPanel.rowActions">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Entry rows -->
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem StackPanel.rowActions">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:pointerover StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected StackPanel.rowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Section headers / fields -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextTertiary}" />
            <Setter Property="Margin" Value="10,12,10,4" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Category row label: keyboard focus must stay visible without shifting layout
             (the transparent 1px border is always reserved). -->
        <Style Selector="Border.categoryRowLabel:focus">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>
        <!-- Row highlighted as the drop parent ("drag into this category"). -->
        <Style Selector="Border.categoryRowLabel.dropTarget">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>
        <!-- Row left behind by a running drag gesture. -->
        <Style Selector="Border.categoryRowLabel.dragSource">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid RowDefinitions="40,*">
            <!-- ==================== Title bar ==================== -->
            <controls:AegisTitleBar Grid.Row="0"
                                    Title="{loc:Str App_Title}"
                                    ShowIcon="True"
                                    ShowMinimize="True"
                                    ShowMaximize="True" />

            <Grid Grid.Row="1" ColumnDefinitions="260,*">
            <!-- ==================== Sidebar ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AegisSidebarBrush}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Margin="8,12,8,8">
                        <StackPanel>
                            <TextBlock Classes="section" Text="{loc:Str Main_SectionViews}" />
                            <ListBox Classes="nav"
                                     Background="Transparent"
                                     ItemsSource="{Binding SystemCategories}"
                                     SelectedItem="{Binding SelectedSystemCategory}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:CategoryItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <ContentControl Grid.Column="0"
                                                            Content="{Binding Converter={StaticResource CategoryIconConverter}}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="section" Text="{loc:Str Main_CategoryField}" />
                                <atom:Button Grid.Column="1"
                                             ButtonType="Text"
                                             AutomationProperties.AutomationId="NewCategoryButton"
                                             Icon="{antd:AntDesignIconProvider PlusOutlined}"
                                             Margin="0,6,4,0"
                                             ToolTip.Tip="{loc:Str Main_NewCategoryTitle}"
                                             Click="OnNewCategoryClicked" />
                            </Grid>
                            <!-- Categories render as a nested, collapsible tree; the row template is the
                                 implicit CategoryNavNode template above and the app owns the inline
                                 NavMenu header template in Theme/CategoryNavMenu.axaml. The NavMenu
                                 stretches (its Inline theme defaults to left-aligned) and drops the
                                 menu content padding so row backgrounds span the sidebar width. -->
                            <atom:NavMenu x:Name="CategoryTree"
                                          AutomationProperties.AutomationId="CategoryTree"
                                          Mode="Inline"
                                          HorizontalAlignment="Stretch"
                                          Padding="0"
                                          Background="Transparent"
                                          IsItemBackgroundEnabled="False"
                                          DefaultOpenPaths="{Binding CategoryOpenPaths}"
                                          ItemsSource="{Binding CategoryNodes}"
                                          SelectedItem="{Binding SelectedCategoryNode}" />


                            <TextBlock Classes="section" Text="{loc:Str Main_Tags}" />
                            <ListBox Classes="nav"
                                     Background="Transparent"
                                     ItemsSource="{Binding TagCategories}"
                                     SelectedItem="{Binding SelectedTagCategory}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:CategoryItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <ContentControl Grid.Column="0"
                                                            Content="{Binding Converter={StaticResource CategoryIconConverter}}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource AegisHairlineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    ToolTip.Tip="{Binding HealthSummary}"
                                    Command="{Binding ShowSecurityCommand}">
                                <TextBlock Text="{Binding HealthCompactText}"
                                           FontSize="12"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{atom:SharedTokenResource ColorWarning}"
                                           IsVisible="{Binding HasSecurityIssues}" />
                            </Button>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding HealthCompactText}"
                                       FontSize="12"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.55"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasSecurityIssues}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                                <!-- Theme modes: the icon follows the active mode (system/light/dark). -->
                                <atom:DropdownButton Name="ThemeButton"
                                                     AutomationProperties.AutomationId="ThemeButton"
                                                     ButtonType="Text"
                                                     TriggerType="Click"
                                                     IsArrowVisible="False"
                                                     IsShowOpenIndicator="False"
                                                     Icon="{Binding ThemePreference, Converter={StaticResource ThemeIconConverter}}"
                                                     ToolTip.Tip="{loc:Str Settings_Theme}"
                                                     Click="OnThemeButtonClicked">
                                    <atom:DropdownButton.DropdownFlyout>
                                        <atom:MenuFlyout Opened="OnThemeFlyoutOpened">
                                            <atom:MenuItem x:Name="ThemeSystemItem"
                                                           Header="{loc:Str Settings_ThemeSystem}"
                                                           ToggleType="Radio"
                                                           GroupName="ThemeMode"
                                                           Click="OnThemeSystemClicked" />
                                            <atom:MenuItem x:Name="ThemeLightItem"
                                                           Header="{loc:Str Settings_ThemeLight}"
                                                           ToggleType="Radio"
                                                           GroupName="ThemeMode"
                                                           Click="OnThemeLightClicked" />
                                            <atom:MenuItem x:Name="ThemeDarkItem"
                                                           Header="{loc:Str Settings_ThemeDark}"
                                                           ToggleType="Radio"
                                                           GroupName="ThemeMode"
                                                           Click="OnThemeDarkClicked" />
                                        </atom:MenuFlyout>
                                    </atom:DropdownButton.DropdownFlyout>
                                </atom:DropdownButton>
                                <!-- Language menu: takes effect after a restart (offered right away). -->
                                <atom:DropdownButton Name="LanguageButton"
                                                     AutomationProperties.AutomationId="LanguageButton"
                                                     ButtonType="Text"
                                                     TriggerType="Click"
                                                     IsArrowVisible="False"
                                                     IsShowOpenIndicator="False"
                                                     Icon="{antd:AntDesignIconProvider TranslationOutlined}"
                                                     ToolTip.Tip="{loc:Str Settings_SectionLanguage}"
                                                     Click="OnLanguageButtonClicked">
                                    <atom:DropdownButton.DropdownFlyout>
                                        <atom:MenuFlyout Opened="OnLanguageFlyoutOpened">
                                            <atom:MenuItem x:Name="LanguageSystemItem"
                                                           Header="{loc:Str Settings_LanguageSystem}"
                                                           ToggleType="Radio"
                                                           GroupName="LanguageMode"
                                                           Click="OnLanguageSystemClicked" />
                                            <atom:MenuItem x:Name="LanguageZhItem"
                                                           Header="{loc:Str Settings_LanguageZh}"
                                                           ToggleType="Radio"
                                                           GroupName="LanguageMode"
                                                           Click="OnLanguageZhClicked" />
                                            <atom:MenuItem x:Name="LanguageEnItem"
                                                           Header="{loc:Str Settings_LanguageEn}"
                                                           ToggleType="Radio"
                                                           GroupName="LanguageMode"
                                                           Click="OnLanguageEnClicked" />
                                        </atom:MenuFlyout>
                                    </atom:DropdownButton.DropdownFlyout>
                                </atom:DropdownButton>
                                <atom:Button ButtonType="Text"
                                             Icon="{antd:AntDesignIconProvider SettingOutlined}"
                                             ToolTip.Tip="{loc:Str Main_Settings}"
                                             AutomationProperties.AutomationId="SettingsButton"
                                             Click="OnSettingsClicked" />
                                <atom:Button ButtonType="Text"
                                             Icon="{antd:AntDesignIconProvider LockOutlined}"
                                             ToolTip.Tip="{loc:Str Main_Lock}"
                                             AutomationProperties.AutomationId="LockButton"
                                             Command="{Binding LockCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== Content card ==================== -->
            <Border Grid.Column="1"
                    Margin="8"
                    CornerRadius="10"
                    Background="{atom:SharedTokenResource ColorBgContainer}"
                    BorderBrush="{DynamicResource AegisCardBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 2 12 0 #14000000">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Toolbar + chips share one header zone; only the chips row
                     bottom hairline separates the header from the list. -->
                <Border Grid.Row="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCategory.DisplayName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FilteredCountText}"
                                       FontSize="12"
                                       Opacity="0.55"
                                       VerticalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <atom:LineEdit x:Name="SearchBox"
                                           AutomationProperties.AutomationId="SearchBox"
                                           Width="290"
                                           PlaceholderText="{loc:Str Main_SearchPlaceholder}"
                                           Text="{Binding SearchText}">
                                <!-- Prefix icon: AtomUI icons ignore host inheritance (P-06), so the
                                     colour is forwarded through a non-interactive button's Foreground. -->
                                <atom:LineEdit.InnerLeftContent>
                                    <atom:Button ButtonType="Text"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"
                                                 Width="16" Height="16"
                                                 MinWidth="0" MinHeight="0"
                                                 Padding="0"
                                                 Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                                                 Icon="{antd:AntDesignIconProvider SearchOutlined}" />
                                </atom:LineEdit.InnerLeftContent>
                            </atom:LineEdit>
                            <atom:Button ButtonType="Default"
                                         Icon="{antd:AntDesignIconProvider ExperimentOutlined}"
                                         Content="{loc:Str Main_Generator}"
                                         Click="OnGeneratePasswordClicked" />
                            <atom:Button ButtonType="Primary"
                                         Icon="{antd:AntDesignIconProvider PlusOutlined}"
                                         Content="{loc:Str Main_NewEntry}"
                                         Command="{Binding AddEntryCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chips -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource AegisHairlineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Classes="chip"
                                    Classes.active="{Binding IsViewAll}"
                                    Content="{loc:Str Main_CategoryAll}"
                                    Command="{Binding SelectViewCommand}"
                                    CommandParameter="all" />
                            <Button Classes="chip"
                                    Classes.active="{Binding IsViewFavorites}"
                                    Content="{loc:Str Main_CategoryFavorites}"
                                    Command="{Binding SelectViewCommand}"
                                    CommandParameter="favorites" />
                            <Button Classes="chip"
                                    Classes.active="{Binding IsViewSecurity}"
                                    Content="{loc:Str Main_CategorySecurity}"
                                    Command="{Binding SelectViewCommand}"
                                    CommandParameter="weak" />
                            <Button Classes="chip"
                                    Classes.active="{Binding IsViewStale}"
                                    Content="{loc:Str Main_CategoryStale}"
                                    Command="{Binding SelectViewCommand}"
                                    CommandParameter="old" />
                            <atom:Button Classes="chip"
                                         IsVisible="{Binding IsViewRecycleBin}"
                                         Icon="{antd:AntDesignIconProvider DeleteOutlined}"
                                         Content="{loc:Str Main_EmptyRecycleBin}"
                                         AutomationProperties.AutomationId="EmptyRecycleBinButton"
                                         Click="OnEmptyRecycleBinClicked" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                            <atom:Button ButtonType="Text"
                                         IsVisible="{Binding CanUndoDelete}"
                                         FontSize="12"
                                         Foreground="{atom:SharedTokenResource ColorPrimary}"
                                         Content="{loc:Str Main_UndoDelete}"
                                         AutomationProperties.AutomationId="UndoDeleteButton"
                                         Command="{Binding UndoDeleteCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <atom:DropdownButton Name="SortButton"
                                                 AutomationProperties.AutomationId="SortButton"
                                                 ButtonType="Text"
                                                 TriggerType="Click"
                                                 IsArrowVisible="False"
                                                 IsShowOpenIndicator="False"
                                                 Icon="{antd:AntDesignIconProvider SortAscendingOutlined}"
                                                 ToolTip.Tip="{loc:Str Main_Sort}"
                                                 Click="OnSortButtonClicked">
                                <atom:DropdownButton.DropdownFlyout>
                                    <atom:MenuFlyout Opened="OnSortFlyoutOpened">
                                        <atom:MenuItem x:Name="SortByNameItem"
                                                       Header="{loc:Str Main_SortName}"
                                                       ToggleType="Radio"
                                                       GroupName="SortMode"
                                                       Click="OnSortByNameClicked" />
                                        <atom:MenuItem x:Name="SortByRecentItem"
                                                       Header="{loc:Str Main_SortRecent}"
                                                       ToggleType="Radio"
                                                       GroupName="SortMode"
                                                       Click="OnSortByRecentClicked" />
                                    </atom:MenuFlyout>
                                </atom:DropdownButton.DropdownFlyout>
                            </atom:DropdownButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body: list + detail -->
                <Grid Grid.Row="2" ColumnDefinitions="360,1,*">
                    <Panel Grid.Column="0" Margin="8,8,4,8">
                        <ListBox Classes="entries"
                                 AutomationProperties.AutomationId="EntriesList"
                                 Background="Transparent"
                                 ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:PasswordEntry">
                                    <!-- Keep only the title in the automation tree; the default name
                                         would be the entry record dump (with password). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          AutomationProperties.Name="{Binding Title}">
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="10"
                                                Margin="0,0,10,0"
                                                Background="{Binding Title, Converter={StaticResource TileBackgroundConverter}}">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource InitialConverter}}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Title, Converter={StaticResource TileForegroundConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- AtomUI icons inherit Foreground from their host; type selectors never match them. -->
                                                <!-- Colored via Button.Foreground: AtomUI icons ignore host inheritance and PathIcon styles. -->
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding IsFavorite}"
                                                             IsHitTestVisible="False"
                                                             Width="16" Height="16"
                                                             MinWidth="0" MinHeight="0"
                                                             Padding="0"
                                                             Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                             Icon="{antd:AntDesignIconProvider StarFilled}" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Classes="rowActions"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    VerticalAlignment="Center">
                                            <atom:Button ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider UserOutlined}"
                                                         ToolTip.Tip="{loc:Str Main_CopyUsernameTip}"
                                                         Click="OnRowCopyUsernameClicked" />
                                            <atom:Button ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider KeyOutlined}"
                                                         ToolTip.Tip="{loc:Str Main_CopyPasswordTip}"
                                                         Click="OnRowCopyPasswordClicked" />
                                            <atom:Button ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider ClockCircleOutlined}"
                                                         ToolTip.Tip="{loc:Str Main_CopyTotpTip}"
                                                         IsVisible="{Binding TotpSecret, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         Click="OnRowCopyTotpClicked" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Str Main_EmptyList}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.45"
                                   IsVisible="{Binding ShowListEmptyHint}" />
                    </Panel>

                    <Border Grid.Column="1" Background="{DynamicResource AegisHairlineBrush}" />

                    <Grid Grid.Column="2" Margin="26,16,12,18" RowDefinitions="*,Auto">
                        <!-- Empty vault: welcome hero with the first-run CTA. -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    MaxWidth="380"
                                    IsVisible="{Binding ShowVaultHero}">
                            <atom:Button ButtonType="Text"
                                         IsHitTestVisible="False"
                                         Focusable="False"
                                         Width="44" Height="44"
                                         MinWidth="0" MinHeight="0"
                                         Padding="0"
                                         HorizontalAlignment="Center"
                                         Foreground="{atom:SharedTokenResource ColorPrimary}"
                                         Icon="{antd:AntDesignIconProvider SafetyCertificateOutlined}" />
                            <TextBlock Text="{loc:Str Main_WelcomeTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Str Main_EmptyVaultHint}"
                                       FontSize="13"
                                       Opacity="0.55"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <atom:Button ButtonType="Primary"
                                             Icon="{antd:AntDesignIconProvider PlusOutlined}"
                                             Content="{loc:Str Main_NewEntry}"
                                             Command="{Binding AddEntryCommand}" />
                                <atom:Button ButtonType="Default"
                                             Icon="{antd:AntDesignIconProvider ImportOutlined}"
                                             Content="{loc:Str Main_ImportData}"
                                             AutomationProperties.AutomationId="ImportDataButton"
                                             Click="OnImportDataClicked" />
                            </StackPanel>
                            <TextBlock Text="{loc:Str Main_ShortcutHint}"
                                       FontSize="12"
                                       Opacity="0.45"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- One-time guide for a fresh vault (dismissal is persisted). -->
                        <Border IsVisible="{Binding ShowStartupGuide}"
                                MaxWidth="400"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="12"
                                Padding="20,18"
                                Background="{atom:SharedTokenResource ColorBgContainer}"
                                BorderBrush="{DynamicResource AegisHairlineBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Str Main_GuideTitle}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                                         Foreground and PathIcon type selectors (see pitfall P-06). -->
                                    <atom:Button ButtonType="Text"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"
                                                 Width="16" Height="16"
                                                 MinWidth="0" MinHeight="0"
                                                 Padding="0"
                                                 VerticalAlignment="Top"
                                                 Margin="0,2,0,0"
                                                 Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                 Icon="{antd:AntDesignIconProvider PlusOutlined}" />
                                    <TextBlock Text="{loc:Str Main_GuideStepNew}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="320" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Text"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"
                                                 Width="16" Height="16"
                                                 MinWidth="0" MinHeight="0"
                                                 Padding="0"
                                                 VerticalAlignment="Top"
                                                 Margin="0,2,0,0"
                                                 Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                 Icon="{antd:AntDesignIconProvider ImportOutlined}" />
                                    <TextBlock Text="{loc:Str Main_GuideStepImport}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="320" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Text"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"
                                                 Width="16" Height="16"
                                                 MinWidth="0" MinHeight="0"
                                                 Padding="0"
                                                 VerticalAlignment="Top"
                                                 Margin="0,2,0,0"
                                                 Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                 Icon="{antd:AntDesignIconProvider ThunderboltOutlined}" />
                                    <TextBlock Text="{loc:Str Main_GuideStepQuickAccess}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="320" />
                                </StackPanel>

                                <atom:Button ButtonType="Primary"
                                             Content="{loc:Str Main_GuideDismiss}"
                                             Command="{Binding DismissStartupGuideCommand}"
                                             AutomationProperties.AutomationId="DismissGuideButton"
                                             HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    IsVisible="{Binding ShowSelectEntryHint}">
                            <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                                 Foreground and PathIcon type selectors (see pitfall P-06). -->
                            <atom:Button ButtonType="Text"
                                         IsHitTestVisible="False"
                                         Focusable="False"
                                         Width="32" Height="32"
                                         MinWidth="0" MinHeight="0"
                                         Padding="0"
                                         HorizontalAlignment="Center"
                                         Opacity="0.6"
                                         Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                                         Icon="{antd:AntDesignIconProvider FileSearchOutlined}" />
                            <TextBlock Text="{loc:Str Main_SelectEntryHint}"
                                       Opacity="0.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer IsVisible="{Binding HasSelection}">
                            <Grid Margin="0,0,16,10">
                                <!-- Preview -->
                                <StackPanel IsVisible="{Binding !IsEditing}">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding EditTitle}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                                                    IsVisible="{Binding !IsViewRecycleBin}">
                                            <atom:Button ButtonType="Text"
                                                         IsVisible="{Binding EditIsFavorite}"
                                                         Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                         Icon="{antd:AntDesignIconProvider StarFilled}"
                                                         ToolTip.Tip="{loc:Str Main_FavoriteToggle}"
                                                         Command="{Binding ToggleFavoriteCommand}" />
                                            <atom:Button ButtonType="Text"
                                                         IsVisible="{Binding !EditIsFavorite}"
                                                         Icon="{antd:AntDesignIconProvider StarOutlined}"
                                                         ToolTip.Tip="{loc:Str Main_FavoriteToggle}"
                                                         Command="{Binding ToggleFavoriteCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Username}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditUsername}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                                <atom:Button ButtonType="Text"
                                                             Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Copy}"
                                                             Command="{Binding CopyUsernameCommand}"
                                                             Click="OnCopyFeedbackClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Password}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding PasswordPreview}"
                                                                 FontFamily="Consolas, Menlo, monospace"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding !IsPasswordRevealed}"
                                                             Icon="{antd:AntDesignIconProvider EyeOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Reveal}"
                                                             Command="{Binding TogglePasswordRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding IsPasswordRevealed}"
                                                             Icon="{antd:AntDesignIconProvider EyeInvisibleOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Hide}"
                                                             Command="{Binding TogglePasswordRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Copy}"
                                                             Command="{Binding CopyPasswordCommand}"
                                                             Click="OnCopyFeedbackClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding HasTotp}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_TotpSection}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource AegisHoverBrush}"
                                                        CornerRadius="8"
                                                        Padding="10,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding TotpCode}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="Consolas, Menlo, monospace" />
                                                        <TextBlock Text="{Binding TotpRemaining, StringFormat='{}{0}s'}"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Copy}"
                                                         Command="{Binding CopyTotpCommand}"
                                                         Click="OnCopyFeedbackClicked" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*">
                                            <TextBlock Grid.Column="0"
                                                       Classes="field"
                                                       Text="{loc:Str Main_Url}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,3,0,0" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding UrlItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <SelectableTextBlock Text="{Binding}"
                                                                                 TextWrapping="Wrap"
                                                                                 VerticalAlignment="Center" />
                                                            <atom:Button Grid.Column="1"
                                                                         ButtonType="Text"
                                                                         Icon="{antd:AntDesignIconProvider LinkOutlined}"
                                                                         ToolTip.Tip="{loc:Str Common_Open}"
                                                                         Click="OnOpenUrlClicked" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding EditPhone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Phone}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditPhone}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Copy}"
                                                         Command="{Binding CopyValueCommand}"
                                                         CommandParameter="{Binding EditPhone}"
                                                         Click="OnCopyFeedbackClicked" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding EditEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Email}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditEmail}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Copy}"
                                                         Command="{Binding CopyValueCommand}"
                                                         CommandParameter="{Binding EditEmail}"
                                                         Click="OnCopyFeedbackClicked" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding EditAppId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_AppId}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditAppId}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Text"
                                                         Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Copy}"
                                                         Command="{Binding CopyValueCommand}"
                                                         CommandParameter="{Binding EditAppId}"
                                                         Click="OnCopyFeedbackClicked" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding EditSecret, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Secret}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding SecretPreview}"
                                                                 FontFamily="Consolas, Menlo, monospace"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding !IsSecretRevealed}"
                                                             AutomationProperties.AutomationId="RevealSecret"
                                                             Icon="{antd:AntDesignIconProvider EyeOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Reveal}"
                                                             Command="{Binding ToggleSecretRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding IsSecretRevealed}"
                                                             Icon="{antd:AntDesignIconProvider EyeInvisibleOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Hide}"
                                                             Command="{Binding ToggleSecretRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Copy}"
                                                             Command="{Binding CopyValueCommand}"
                                                             CommandParameter="{Binding EditSecret}"
                                                             Click="OnCopyFeedbackClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding EditApiKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_ApiKey}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding ApiKeyPreview}"
                                                                 FontFamily="Consolas, Menlo, monospace"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding !IsApiKeyRevealed}"
                                                             AutomationProperties.AutomationId="RevealApiKey"
                                                             Icon="{antd:AntDesignIconProvider EyeOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Reveal}"
                                                             Command="{Binding ToggleApiKeyRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             IsVisible="{Binding IsApiKeyRevealed}"
                                                             Icon="{antd:AntDesignIconProvider EyeInvisibleOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Hide}"
                                                             Command="{Binding ToggleApiKeyRevealCommand}" />
                                                <atom:Button ButtonType="Text"
                                                             Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                             ToolTip.Tip="{loc:Str Common_Copy}"
                                                             Command="{Binding CopyValueCommand}"
                                                             CommandParameter="{Binding EditApiKey}"
                                                             Click="OnCopyFeedbackClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_CategoryField}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding CategoryDisplayName}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Tags}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditTags}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding CreatedAtDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_CreatedAt}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding CreatedAtDisplay}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- ROT-1a: password age + rotation guidance. -->
                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10"
                                            IsVisible="{Binding PasswordAgeDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_PasswordAge}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PasswordAgeDisplay}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Link"
                                                         AutomationProperties.AutomationId="RotatePasswordButton"
                                                         Content="{loc:Str Main_RotatePassword}"
                                                         Command="{Binding StartRotationCommand}"
                                                         IsVisible="{Binding !IsViewRecycleBin}" />
                                        </Grid>
                                    </Border>

                                    <!-- ROT-1b: superseded passwords (encrypted payload). -->
                                    <StackPanel Spacing="6"
                                                Margin="0,10,0,0"
                                                IsVisible="{Binding HasPasswordHistory}">
                                        <TextBlock Classes="field" Text="{loc:Str Main_PasswordHistory}" />
                                        <ItemsControl AutomationProperties.AutomationId="PasswordHistoryList"
                                                      ItemsSource="{Binding PasswordHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:PasswordHistoryItem">
                                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding ChangedAtDisplay}"
                                                                       Opacity="0.65"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="••••••••"
                                                                       Opacity="0.5"
                                                                       Margin="12,0"
                                                                       VerticalAlignment="Center" />
                                                            <atom:Button Grid.Column="2"
                                                                         ButtonType="Link"
                                                                         Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                                                         ToolTip.Tip="{loc:Str Main_CopyHistoryPassword}"
                                                                         Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyHistoryPasswordCommand}"
                                                                         CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource AegisHairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Main_Notes}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding EditNotes}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding DeletedAtDisplay}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               Margin="0,14,0,0"
                                               IsVisible="{Binding IsViewRecycleBin}" />
                                </StackPanel>

                                <!-- Editor -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsEditing}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Classes="field" Text="{loc:Str Main_Title}" />
                                            <TextBlock Text="*"
                                                       FontSize="13"
                                                       Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <atom:LineEdit Text="{Binding EditTitle}" />
                                        <TextBlock Text="{Binding TitleError}"
                                                   Foreground="{atom:SharedTokenResource ColorError}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Username}" />
                                        <atom:LineEdit Text="{Binding EditUsername}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Password}" />
                                        <Grid ColumnDefinitions="*,8,Auto">
                                            <atom:LineEdit Grid.Column="0"
                                                           PasswordChar="●"
                                                           IsEnableRevealButton="True"
                                                           Text="{Binding EditPassword, Mode=TwoWay}" />
                                            <atom:Button Grid.Column="2"
                                                         ButtonType="Default"
                                                         Icon="{antd:AntDesignIconProvider ThunderboltOutlined}"
                                                         Content="{loc:Str Common_Generate}"
                                                         Click="OnGeneratePasswordClicked" />
                                        </Grid>
                                        <atom:ProgressBar Value="{Binding EditPasswordStrengthPercent}"
                                                          Maximum="100"
                                                          Height="6"
                                                          Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding EditPasswordStrengthSummary}"
                                                   FontSize="12"
                                                   Opacity="0.75" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Url}" />
                                        <atom:TextArea AcceptsReturn="True"
                                                       TextWrapping="Wrap"
                                                       Height="64"
                                                       Text="{Binding EditUrls}" />
                                        <TextBlock Text="{loc:Str Main_UrlsHint}"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                        <TextBlock Text="{Binding UrlError}"
                                                   Foreground="{atom:SharedTokenResource ColorError}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding UrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_TotpSecret}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <atom:LineEdit Grid.Column="0"
                                                           Name="TotpSecretBox"
                                                           AutomationProperties.AutomationId="TotpSecretBox"
                                                           Text="{Binding EditTotpSecret}"
                                                           PasswordChar="●"
                                                           RevealPassword="{Binding IsTotpSecretRevealed}" />
                                            <atom:Button Grid.Column="1"
                                                         ButtonType="Text"
                                                         IsVisible="{Binding !IsTotpSecretRevealed}"
                                                         AutomationProperties.AutomationId="RevealTotpSecret"
                                                         Icon="{antd:AntDesignIconProvider EyeOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Reveal}"
                                                         Command="{Binding ToggleTotpRevealCommand}" />
                                            <atom:Button Grid.Column="1"
                                                         ButtonType="Text"
                                                         IsVisible="{Binding IsTotpSecretRevealed}"
                                                         Icon="{antd:AntDesignIconProvider EyeInvisibleOutlined}"
                                                         ToolTip.Tip="{loc:Str Common_Hide}"
                                                         Command="{Binding ToggleTotpRevealCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_CategoryField}" />
                                        <atom:ComboBox ItemsSource="{Binding CategoryChoices}"
                                                       SelectedItem="{Binding SelectedCategoryChoice}"
                                                       HorizontalAlignment="Stretch">
                                            <atom:ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:CategoryChoice">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </atom:ComboBox.ItemTemplate>
                                        </atom:ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_TagsComma}" />
                                        <atom:LineEdit Text="{Binding EditTags}" />
                                    </StackPanel>

                                    <TextBlock Classes="section" Text="{loc:Str Main_SectionExtraFields}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Phone}" />
                                        <atom:LineEdit Text="{Binding EditPhone}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Email}" />
                                        <atom:LineEdit Text="{Binding EditEmail}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_AppId}" />
                                        <atom:LineEdit Text="{Binding EditAppId}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Secret}" />
                                        <atom:LineEdit PasswordChar="●"
                                                       IsEnableRevealButton="True"
                                                       Text="{Binding EditSecret, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_ApiKey}" />
                                        <atom:LineEdit PasswordChar="●"
                                                       IsEnableRevealButton="True"
                                                       Text="{Binding EditApiKey, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field" Text="{loc:Str Main_Notes}" />
                                        <atom:TextArea AcceptsReturn="True"
                                                       TextWrapping="Wrap"
                                                       Height="90"
                                                       Text="{Binding EditNotes}" />
                                    </StackPanel>

                                    <atom:CheckBox Content="{loc:Str Main_Favorite}"
                                                   IsChecked="{Binding EditIsFavorite, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Sticky action bar: pinned below the scroll region so
                             Save/Cancel stay reachable without scrolling to the end. -->
                        <Border Grid.Row="1"
                                x:Name="DetailActionBar"
                                IsVisible="{Binding HasSelection}"
                                Margin="0,0,16,0"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                Background="{atom:SharedTokenResource ColorBgContainer}"
                                Padding="0,10,0,0">
                            <Panel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding !IsEditing}">
                                    <atom:Button ButtonType="Primary"
                                                 AutomationProperties.AutomationId="DetailEditButton"
                                                 IsVisible="{Binding !IsViewRecycleBin}"
                                                 Icon="{antd:AntDesignIconProvider EditOutlined}"
                                                 Content="{loc:Str Common_Edit}"
                                                 Command="{Binding BeginEditCommand}" />
                                    <atom:Button ButtonType="Default"
                                                 AutomationProperties.AutomationId="DetailDeleteButton"
                                                 IsVisible="{Binding !IsViewRecycleBin}"
                                                 Icon="{antd:AntDesignIconProvider DeleteOutlined}"
                                                 Content="{loc:Str Common_Delete}"
                                                 Click="OnDeleteEntryClicked" />
                                    <atom:Button ButtonType="Primary"
                                                 AutomationProperties.AutomationId="DetailRestoreButton"
                                                 IsVisible="{Binding IsViewRecycleBin}"
                                                 Icon="{antd:AntDesignIconProvider UndoOutlined}"
                                                 Content="{loc:Str Main_RestoreEntry}"
                                                 Command="{Binding RestoreSelectedEntryCommand}" />
                                    <atom:Button ButtonType="Default"
                                                 AutomationProperties.AutomationId="DetailPurgeButton"
                                                 IsVisible="{Binding IsViewRecycleBin}"
                                                 Icon="{antd:AntDesignIconProvider DeleteOutlined}"
                                                 Content="{loc:Str Main_DeleteForever}"
                                                 Click="OnPurgeEntryClicked" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding IsEditing}">
                                    <atom:Button ButtonType="Default"
                                                 AutomationProperties.AutomationId="DetailCancelButton"
                                                 Content="{loc:Str Common_Cancel}"
                                                 Command="{Binding CancelEditCommand}" />
                                    <atom:Button ButtonType="Primary"
                                                 AutomationProperties.AutomationId="DetailSaveButton"
                                                 Icon="{antd:AntDesignIconProvider CheckOutlined}"
                                                 Content="{loc:Str Common_Save}"
                                                 Command="{Binding SaveEntryCommand}" />
                                </StackPanel>
                            </Panel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ==================== Clipboard toast ==================== -->
        <Border x:Name="ClipboardToast"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                CornerRadius="10"
                Padding="14,8"
                Background="#E6303030"
                BoxShadow="0 4 12 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ClipboardToastText}"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <atom:Button ButtonType="Default"
                             Content="{loc:Str Main_ClearNow}"
                             Command="{Binding ClearClipboardNowCommand}" />
            </StackPanel>
        </Border>

        <!-- ==================== Lock overlay ==================== -->
        <Border x:Name="LockOverlay"
                IsVisible="False"
                Background="{atom:SharedTokenResource ColorBgLayout}">
            <Panel>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AegisHairlineBrush}"
                        Background="{atom:SharedTokenResource ColorBgContainer}"
                        Padding="36,28"
                        BoxShadow="0 8 24 0 #30000000">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                             Foreground and PathIcon type selectors (see pitfall P-06). -->
                        <atom:Button ButtonType="Text"
                                     IsHitTestVisible="False"
                                     Focusable="False"
                                     Width="36" Height="36"
                                     MinWidth="0" MinHeight="0"
                                     Padding="0"
                                     HorizontalAlignment="Center"
                                     Foreground="{atom:SharedTokenResource ColorPrimary}"
                                     Icon="{antd:AntDesignIconProvider LockFilled}" />
                        <TextBlock Text="{loc:Str Main_Locked}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Main_LockedHint}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center" />
                        <atom:Button x:Name="UnlockButton"
                                     ButtonType="Primary"
                                     Content="{loc:Str Main_Unlock}"
                                     MinWidth="120"
                                     HorizontalAlignment="Center"
                                     Click="OnUnlockClicked" />
                    </StackPanel>
                </Border>
            </Panel>
        </Border>

        <!-- ==================== Drag ghost ====================
             A small chip that follows the pointer while a category row is dragged,
             so the gesture reads as "carrying this row". Positioned through Canvas
             coordinates (no layout pass) and never hit-testable. -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="CategoryDragGhost"
                    IsVisible="False"
                    Opacity="0"
                    Padding="8,4"
                    CornerRadius="6"
                    Background="{atom:SharedTokenResource ColorBgElevated}"
                    BorderBrush="{atom:SharedTokenResource ColorPrimary}"
                    BorderThickness="1">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <TextBlock x:Name="CategoryDragGhostLabel"
                           FontSize="12"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{atom:SharedTokenResource ColorText}" />
            </Border>
        </Canvas>
    </Panel>
</Window>
