<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        x:Class="AegisVault.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/app.png"
        Title="{loc:Str Settings_Title}"
        Width="640" Height="760"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{atom:SharedTokenResource ColorBgContainer}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Window.Styles>
        <!-- Flat white surface: sections are separated by hairline outlines. -->
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource AegisHairlineBrush}" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="40,*,Auto">
        <controls:AegisTitleBar Grid.Row="0"
                                Title="{loc:Str Settings_Title}"
                                ShowIcon="True"
                                ShowMinimize="True"
                                ShowMaximize="True" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20" Spacing="14">
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionSecurity}" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="field" Text="{loc:Str Settings_AutoLock}" />
                            <atom:ComboBox ItemsSource="{Binding AutoLockOptions}"
                                           SelectedItem="{Binding SelectedAutoLock}"
                                           HorizontalAlignment="Stretch">
                                <atom:ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:AutoLockOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </atom:ComboBox.ItemTemplate>
                            </atom:ComboBox>
                        </StackPanel>
                        <atom:CheckBox Content="{loc:Str Settings_LockOnMinimize}" IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                        <atom:CheckBox Content="{loc:Str Settings_LockOnScreenLock}" IsChecked="{Binding LockOnScreenLock, Mode=TwoWay}" />
                        <atom:CheckBox Content="{loc:Str Settings_LockOnSuspend}" IsChecked="{Binding LockOnSuspend, Mode=TwoWay}" />
                        <atom:CheckBox x:Name="ScreenGuardCheckBox"
                                       IsEnabled="{Binding ScreenGuardSupported}"
                                       IsChecked="{Binding DisableScreenCapture, Mode=TwoWay}"
                                       Content="{loc:Str Settings_ScreenGuard}" />
                        <TextBlock Text="{loc:Str Settings_ScreenGuardHint}"
                                   FontSize="12" Opacity="0.6"
                                   IsVisible="{Binding ScreenGuardSupported}" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="field" Text="{loc:Str Settings_Clipboard}" />
                            <atom:ComboBox ItemsSource="{Binding ClipboardOptions}"
                                           SelectedItem="{Binding SelectedClipboard}"
                                           HorizontalAlignment="Stretch">
                                <atom:ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ClipboardOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </atom:ComboBox.ItemTemplate>
                            </atom:ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionMasterPassword}" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Classes="field" Text="{loc:Str Settings_NewMasterPassword}" />
                                <atom:LineEdit PasswordChar="●"
                                               IsEnableRevealButton="True"
                                               Text="{Binding NewMasterPassword, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Classes="field" Text="{loc:Str Settings_ConfirmNewMasterPassword}" />
                                <atom:LineEdit PasswordChar="●"
                                               IsEnableRevealButton="True"
                                               Text="{Binding ConfirmMasterPassword, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <atom:Button Content="{loc:Str Settings_ChangeMasterPassword}"
                                     ButtonType="Primary"
                                     Command="{Binding ChangeMasterPasswordCommand}"
                                     HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionDeviceKey}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Opacity="0.75"
                                   Text="{loc:Str Settings_DeviceKeySaved}"
                                   IsVisible="{Binding HasDeviceKey}" />
                        <TextBlock FontSize="12" Opacity="0.75"
                                   Text="{loc:Str Settings_DeviceKeyNotSaved}"
                                   IsVisible="{Binding !HasDeviceKey}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DeviceKeySupported}">
                            <atom:Button Content="{loc:Str Settings_RememberDevice}"
                                         Command="{Binding RememberDeviceCommand}"
                                         IsVisible="{Binding !HasDeviceKey}" />
                            <atom:Button Content="{loc:Str Settings_ForgetDevice}"
                                         Command="{Binding ForgetDeviceCommand}"
                                         IsVisible="{Binding HasDeviceKey}" />
                        </StackPanel>
                        <TextBlock FontSize="12"
                                   Opacity="0.6"
                                   Text="{loc:Str Settings_DeviceKeyUnsupported}"
                                   IsVisible="{Binding !DeviceKeySupported}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionAppearance}" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="field" Text="{loc:Str Settings_Theme}" />
                            <atom:ComboBox ItemsSource="{Binding ThemeOptions}"
                                           SelectedItem="{Binding SelectedTheme}"
                                           HorizontalAlignment="Stretch">
                                <atom:ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ThemeOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </atom:ComboBox.ItemTemplate>
                            </atom:ComboBox>
                        </StackPanel>
                        <atom:CheckBox Content="{loc:Str Settings_ShowFloatingBall}"
                                       IsChecked="{Binding ShowFloatingBall, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionWindow}" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="field" Text="{loc:Str Settings_CloseBehavior}" />
                            <atom:ComboBox ItemsSource="{Binding CloseBehaviorOptions}"
                                           SelectedItem="{Binding SelectedCloseBehavior}"
                                           HorizontalAlignment="Stretch">
                                <atom:ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:CloseBehaviorOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </atom:ComboBox.ItemTemplate>
                            </atom:ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16" IsVisible="{Binding StartupSupported}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionStartup}" FontSize="14" FontWeight="SemiBold" />
                        <atom:CheckBox x:Name="AutoStartCheckBox"
                                       Content="{loc:Str Settings_AutoStart}"
                                       IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                        <atom:CheckBox Content="{loc:Str Settings_StartMinimized}"
                                       IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                        <TextBlock Text="{loc:Str Settings_StartupHint}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionLanguage}" FontSize="14" FontWeight="SemiBold" />
                        <atom:ComboBox ItemsSource="{Binding LanguageOptions}"
                                       SelectedItem="{Binding SelectedLanguage}"
                                       HorizontalAlignment="Stretch">
                            <atom:ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:LanguageOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </atom:ComboBox.ItemTemplate>
                        </atom:ComboBox>
                        <TextBlock Text="{loc:Str Settings_LanguageRestart}" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionGenerator}" FontSize="14" FontWeight="SemiBold" />
                        <atom:Slider Minimum="8" Maximum="64"
                                     TickFrequency="1"
                                     IsSnapToTickEnabled="True"
                                     Value="{Binding GeneratorLength}" />
                        <TextBlock Text="{Binding GeneratorLengthText}" FontSize="12" Opacity="0.7" />
                        <atom:CheckBox Content="{loc:Str Settings_GeneratorSymbols}" IsChecked="{Binding GeneratorSymbols, Mode=TwoWay}" />
                        <atom:CheckBox Content="{loc:Str Settings_GeneratorAmbiguous}" IsChecked="{Binding GeneratorExcludeAmbiguous, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionData}" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <atom:Button Content="{loc:Str Settings_BackupTo}" Click="OnBackupClicked" />
                                <atom:Button Content="{loc:Str Settings_ImportCsv}" Click="OnImportClicked" />
                                <atom:Button Content="{loc:Str Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <atom:Button Content="{loc:Str Settings_ExportCsv}" Click="OnExportCsvClicked" />
                                <atom:Button Content="{loc:Str Settings_ExportEncrypted}" Click="OnExportEncryptedClicked" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:Str Settings_ImportHint}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Str Settings_ExportHint}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Settings_SectionAbout}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.75" />
                        <TextBlock Text="{loc:Str Settings_AboutLicense}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                BorderBrush="{DynamicResource AegisHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{atom:SharedTokenResource ColorSuccess}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <atom:Button Content="{loc:Str Common_Close}" Click="OnCloseClicked" />
                    <atom:Button ButtonType="Primary"
                                 Content="{loc:Str Settings_SaveSettings}"
                                 AutomationProperties.AutomationId="SaveSettingsButton"
                                 Command="{Binding SaveCommand}"
                                 IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
